# eztunes - environment template
#
# Copy to .env and fill in the values. NEVER commit the filled-in file.
# In Docker these are set as container environment variables instead.

# --- required -------------------------------------------------------------

# The credential the operator types into the app to unlock it. Generate one
# with:  openssl rand -base64 32
EZTUNES_API_TOKEN=

# Signs the session cookie. Changing it invalidates every existing session.
# Generate one with:  openssl rand -base64 32
EZTUNES_SESSION_SECRET=

# Authenticates the worker's progress broadcasts to the server. Must be
# different from EZTUNES_API_TOKEN.
# Generate one with:  openssl rand -base64 32
EZTUNES_INTERNAL_TOKEN=

# Song recognition. Create a free account at https://dashboard.audd.io and
# copy the API token. Without a working token every track is named
# "Unknown Track NN" - the split still works, the tagging does not.
AUDD_API_TOKEN=

# --- network --------------------------------------------------------------

# The port the server listens on.
PORT=5000

# Bind address. Leave this at 127.0.0.1 unless the container or reverse
# proxy needs otherwise. 0.0.0.0 exposes the service to the network.
HOST=127.0.0.1

# Set to true when serving over HTTPS so the session cookie carries the
# Secure attribute.
COOKIE_SECURE=false

# --- storage --------------------------------------------------------------

# Writable directory for the database and the produced zips. Mount this as
# a volume so jobs survive a container restart.
DATA_DIR=/data

# Where the finished zips are written. Defaults to $DATA_DIR/blackhole.
# OUTPUT_DIR=/data/blackhole

# The SQLite file. Defaults to $DATA_DIR/eztunes.sqlite.
# DB_PATH=/data/eztunes.sqlite

# The built frontend bundle. The server serves it directly.
# FRONTEND_DIR=/app/frontend/dist

# --- worker ---------------------------------------------------------------

# How often the worker looks for a queued job.
POLL_INTERVAL_MS=3000

# How often the sweeper runs.
SWEEP_INTERVAL_MS=43200000

# A job stuck in "processing" for longer than this is presumed dead and is
# cleaned up. A job that is merely "pending" is never touched.
STUCK_JOB_MS=21600000

# Completed jobs older than this are pruned, along with their zip.
RETENTION_MS=604800000

# Where the worker pushes progress. The default assumes the server runs in
# the same container.
# BROADCAST_URL=http://127.0.0.1:5000/api/internal/broadcast

# The ffmpeg binary. Defaults to whatever is on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
